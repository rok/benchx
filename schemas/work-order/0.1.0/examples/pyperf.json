{
  "workorder_version": 1,
  "project": "scipy",
  "source": {
    "uri": "https://github.com/scipy/scipy",
    "type": "git"
  },
  "harness": {
    "name": "pyperf"
  },
  "target": {
    "kind": "python_env",
    "python": "/tmp/scipy-bench/.venv/bin/python",
    "source_dir": "/tmp/scipy"
  },
  "suite": "benchmarks/bench_optimize.py",
  "quantities": ["wall-time"],
  "protocol": {
    "repetitions": {
      "mode": "fixed",
      "levels": [
        { "unit": "process", "n": 20 },
        { "unit": "value", "n": 3 }
      ]
    },
    "calibration": {
      "mode": "adaptive",
      "minimum_sample_seconds": 0.1
    },
    "warmup": {
      "mode": "fixed",
      "n_warmup": 1
    }
  },
  "provenance": {
    "run_key": "local-2026-09-23-a",
    "requested_by": "ev-br",
    "reason": "baseline before the optimize change",
    "labels": {
      "side": "baseline"
    }
  }
}
